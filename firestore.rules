rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read products (for browsing the marketplace)
    match /products/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Allow authenticated users to access their own user data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if false; // Prevent listing all users
    }

    // Allow authenticated users to create and manage orders
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Allow authenticated users to manage their cart
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow public read access to categories
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Allow authenticated users to read their transactions
    match /transactions/{transactionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false; // Managed by backend only
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
