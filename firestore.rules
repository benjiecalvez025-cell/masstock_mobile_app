rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: any authenticated user can read and write
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }

    // Users: authenticated users can only access their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Stores: any authenticated user can read and write
    match /stores/{storeId} {
      allow read, write: if request.auth != null;
    }

    // Orders: authenticated users can create; owners can read/update their own
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.userId;
    }

    // Carts: owners only
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Categories: any authenticated user can read and write
    match /categories/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Transactions: owners can read, no client writes
    match /transactions/{transactionId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
